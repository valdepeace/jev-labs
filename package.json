{
  "name": "poc-jev-agent-coder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "classify": "tsx --env-file=.env scripts/run-benchmark.ts --out-dir pocs/jev-kev-laya/results",
    "classify:tiers": "tsx --env-file=.env scripts/run-benchmark.ts --pool tiers --out-dir pocs/jev-kev-laya/results",
    "classify:laya": "tsx scripts/run-laya-benchmark.ts --out-dir pocs/jev-kev-laya/results",
    "classify:laya:tiers": "tsx scripts/run-laya-benchmark.ts --pool tiers --out-dir pocs/jev-kev-laya/results",
    "prepare": "tsx scripts/prepare-wildchat.ts",
    "analyze": "tsx scripts/analyze-results.ts",
    "report": "tsx scripts/report.ts pocs/jev-kev-laya/results/benchmark-2026-09-27T14-44-37.993Z.jsonl pocs/jev-kev-laya/results/laya-2026-09-27T14-44-37.980Z.jsonl pocs/jev-kev-laya/results/kev-wide-2026-09-27T16-59-09.765Z.jsonl pocs/jev-kev-laya/results/router-2026-09-27T16-31-17.126Z.jsonl",
    "cache-affinity": "tsx pocs/cache-affinity/run-simulation.ts",
    "site": "tsx scripts/site.ts",
    "audit": "tsx scripts/audit-secrets.ts",
    "test": "tsx --test scripts/*.test.ts src/*.test.ts pocs/*/*.test.ts"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
